---
import "@/styles/global.css";
interface Props {
	title?: string;
}
const { title = "Gabriel Ballesteros | Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/logogit.jpeg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-ink text-text antialiased overflow-x-hidden w-full selection:bg-accent/30 selection:text-accent">
		<div class="fixed inset-0 -z-10 h-full w-full bg-ink blueprint-grid"></div>
		<div
			class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[70vh] w-full"
			style="background: radial-gradient(70% 60% at 50% 0%, rgba(255,180,84,0.06) 0%, transparent 70%);"
		>
		</div>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>

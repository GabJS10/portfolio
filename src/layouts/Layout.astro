---
import "@/styles/global.css";
interface Props {
	title?: string;
	description?: string;
}
const {
	title = "Gabriel Ballesteros | Portfolio",
	description = "Gabriel Ballesteros, ingeniero de sistemas. Software backend y full-stack eficiente, escalable y pensado para producción.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0d0d0e" />
		<link rel="icon" type="image/jpeg" href="/logogit.jpeg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="w-full overflow-x-hidden bg-wall text-ink antialiased">
		<slot />
	</body>
</html>

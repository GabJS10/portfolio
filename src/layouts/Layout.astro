---
import "@/styles/global.css";
interface Props {
	title?: string;
}
const { title = "Gabriel Ballesteros | Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/logogit.jpeg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-ink text-text antialiased overflow-x-hidden w-full selection:bg-accent/30 selection:text-accent">
		<div class="fixed inset-0 -z-10 h-full w-full bg-ink blueprint-grid"></div>
		<div
			class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
			style="background:
				radial-gradient(48% 40% at 8% 4%, rgba(139,124,255,0.18) 0%, transparent 60%),
				radial-gradient(42% 36% at 96% 10%, rgba(53,214,232,0.14) 0%, transparent 60%);"
		>
		</div>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>

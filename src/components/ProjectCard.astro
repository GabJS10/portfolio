---
import { isoDate } from "@/lib/dates";
import { techName } from "@/lib/tech";

interface Props {
	id: string;
	title: string;
	description: string;
	date: string;
	image: string;
	url: string;
	technologies: string[];
	showYear?: boolean;
}

const { id, title, url, date, description, image, technologies, showYear = true } = Astro.props;

const iso = isoDate(date);
const year = iso.slice(0, 4);
const isRepo = url.includes("github.com");
---

<article
	id={`obra-${id}`}
	class="grid scroll-mt-24 gap-6 md:grid-cols-12 md:gap-x-8"
	aria-labelledby={`titulo-${id}`}
>
	<!-- Regla de años al margen: marca solo donde cambia el año -->
	<div class="hidden md:col-span-1 md:block" aria-hidden="true">
		{
			showYear && (
				<p class="tabular -ml-px flex items-center gap-3 text-sm text-dim">
					<span class="h-px w-3 bg-dim" />
					{year}
				</p>
			)
		}
	</div>

	<!-- La obra -->
	<a
		href={url}
		target="_blank"
		rel="noopener noreferrer"
		class="work block md:col-span-7"
		tabindex="-1"
		aria-hidden="true"
	>
		<div class="aspect-[16/10] overflow-hidden bg-wall-2 shadow-[0_40px_60px_-40px_rgb(0_0_0/0.9)]">
			<img
				src={image}
				alt=""
				loading="lazy"
				decoding="async"
				class="work-image h-full w-full object-cover object-top"
			/>
		</div>
	</a>

	<!-- Cartela -->
	<div class="flex flex-col justify-end md:col-span-4">
		<h3 id={`titulo-${id}`} class="text-2xl font-medium tracking-[-0.01em] text-balance text-ink">{title}</h3>
		<p class="tabular mt-1 text-sm text-dim md:sr-only">
			<time datetime={iso}>{year}</time>
		</p>
		<p class="mt-4 text-sm leading-relaxed text-dim">{technologies.map(techName).join(", ")}</p>
		<p class="mt-4 max-w-[46ch] text-[15px] leading-relaxed text-ink/80">{description}</p>
		<a
			href={url}
			target="_blank"
			rel="noopener noreferrer"
			class="link-arrow mt-6 inline-flex items-center gap-1.5 self-start text-sm text-ink underline decoration-rule underline-offset-[6px] transition-colors hover:text-lamp hover:decoration-lamp"
		>
			{isRepo ? "Ver código" : "Visitar sitio"}<span class="sr-only"> de {title}</span>
			<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
		</a>
	</div>
</article>

---
import { techIcons } from "@/constants/icons";
interface Props {
	index: string;
	title: string;
	description: string;
	date: string;
	image: string;
	url: string;
	technologies: string[];
	reverse?: boolean;
}

const {
	index,
	title,
	url,
	date,
	description,
	image,
	technologies,
	reverse = false,
} = Astro.props;
---

<article
	class={`flex flex-col ${reverse ? "md:flex-row-reverse" : "md:flex-row"} items-center gap-10 md:gap-16`}
>
	<div class="flex-1 space-y-5 text-center md:text-left">
		<div
			class="flex items-center justify-center gap-3 font-mono text-xs text-muted md:justify-start"
		>
			<span class="text-accent">[{index}]</span>
			<span class="h-px w-8 bg-line"></span>
			<span>{date}</span>
		</div>

		<h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight text-text">
			{title}
		</h3>

		<p class="leading-relaxed text-muted">
			{description}
		</p>

		<div class="flex flex-wrap justify-center gap-2 pt-1 md:justify-start">
			{
				technologies.map((techName) => {
					const svgContent =
						techIcons[techName.toLowerCase()] || techIcons.default;
					return (
						<span class="flex items-center gap-2 rounded-md border border-line bg-panel/60 py-1.5 pl-2 pr-2.5 font-mono text-[11px] tracking-wide text-muted transition-colors duration-300 hover:border-accent/40 hover:text-text">
							<span class="inline-flex h-4 w-4 items-center justify-center [&>svg]:h-full [&>svg]:w-full">
								<Fragment set:html={svgContent} />
							</span>
							{techName}
						</span>
					);
				})
			}
		</div>

		<div class="pt-2">
			<a
				href={url}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 font-mono text-xs tracking-widest text-accent transition-colors hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
			>
				VER PROYECTO
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</div>

	<div class="w-full flex-1">
		<a
			href={url}
			target="_blank"
			rel="noopener noreferrer"
			class="group relative block overflow-hidden rounded-xl border border-line bg-panel focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
		>
			<div
				class="pointer-events-none absolute inset-0 z-10 rounded-xl ring-1 ring-inset ring-accent/0 transition-all duration-500 group-hover:ring-accent/40"
			>
			</div>
			<img
				src={image}
				alt={`Captura de pantalla del proyecto ${title}`}
				loading="lazy"
				class="w-full transition-transform duration-500 ease-out group-hover:scale-[1.03]"
			/>
		</a>
	</div>
</article>

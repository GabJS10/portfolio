---
interface Props {
	index: string; // "01"
	eyebrow: string; // "SOBRE MÍ"
	title: string;
	description?: string;
}
const { index, eyebrow, title, description } = Astro.props;
---

<div class="reveal-on-scroll space-y-5">
	<div class="flex items-center gap-3 font-mono text-xs tracking-widest text-accent">
		<span>// {index}</span>
		<span class="h-px flex-1 max-w-24 bg-line"></span>
		<span class="text-muted">{eyebrow}</span>
	</div>
	<h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-text">
		{title}
	</h2>
	{
		description && (
			<p class="max-w-2xl text-muted leading-relaxed">{description}</p>
		)
	}
</div>

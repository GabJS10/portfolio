---
interface Props {
	href: string;
	label: string;
}
const { href, label } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class="group flex items-center gap-3 rounded-lg border border-line bg-panel/60 px-4 py-2.5 text-muted transition-colors duration-300 hover:border-accent/50 hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
	<span class="text-muted transition-colors duration-300 group-hover:text-accent">
		<slot />
	</span>
	<span class="font-mono text-xs tracking-wide">{label}</span>
</a>

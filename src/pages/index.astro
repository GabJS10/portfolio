---
import Layout from "@/layouts/Layout.astro";
import SocialLink from "@/components/SocialLink.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { Image } from "astro:assets";
import Foto from "@/assets/foto.jpeg";
import { techIcons } from "@/constants/icons";
import { getCollection } from "astro:content";

const navItems = [
	{ name: "Sobre mí", href: "#sobre-mi" },
	{ name: "Stack", href: "#stack" },
	{ name: "Proyectos", href: "#proyectos" },
	{ name: "Contacto", href: "#contacto" },
	{
		name: "CV",
		href: "https://docs.google.com/document/d/1MXRKo2KKJapOG70Ydf2bWkq1aL-uaA-qlnbaygS2s2M/edit?tab=t.0",
		props: { target: "_blank", rel: "noopener noreferrer" },
	},
];

const readout = [
	{ label: "LOC", value: "Colombia" },
	{ label: "STACK", value: "TS · Python" },
	{ label: "FOCUS", value: "Backend / Full-stack" },
	{ label: "STATUS", value: "Disponible" },
];

const facts = [
	{ label: "Rol", value: "Ingeniero de sistemas" },
	{ label: "Enfoque", value: "Backend / Full-stack" },
	{ label: "Ubicación", value: "Colombia" },
	{ label: "Bases de datos", value: "SQL · NoSQL" },
];

const stackGroups = [
	{
		label: "Frontend",
		items: ["react", "nextjs", "astro", "tailwind", "typescript", "javascript"],
	},
	{
		label: "Backend",
		items: ["nodejs", "express", "nestjs", "fastapi", "python"],
	},
	{
		label: "Datos & Infra",
		items: ["postgresql", "mongodb", "redis", "docker", "git"],
	},
];

const projects = await getCollection("projects");
---

<Layout title="Gabriel Ballesteros | Portfolio">
	<header
		class="fixed top-0 left-0 right-0 z-50 border-b border-line bg-ink/70 backdrop-blur-md"
	>
		<nav
			class="mx-auto flex max-w-5xl flex-row items-center justify-between px-4 py-4 md:px-6"
		>
			<a
				href="/"
				class="font-mono text-sm font-medium tracking-tight text-text transition-colors hover:text-accent"
			>
				GAB<span class="text-accent">JS</span>10
			</a>

			<ul
				class="flex gap-4 font-mono text-xs tracking-wide text-muted md:gap-7 md:text-[13px]"
			>
				{
					navItems.map((item) => (
						<li>
							<a
								{...item.props}
								href={item.href}
								class="transition-colors hover:text-accent"
							>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</header>

	<main class="px-4 sm:px-6">
		<!-- HERO -->
		<section
			class="relative mx-auto flex min-h-screen max-w-5xl flex-col justify-center pt-28 pb-16"
		>
			<div class="load-seq grid items-center gap-12 md:grid-cols-[1.4fr_1fr]">
				<div class="space-y-6 text-center md:text-left">
					<p
						class="font-mono text-xs tracking-widest text-accent md:text-sm"
					>
						> ingeniero de sistemas<span class="caret"></span>
					</p>

					<h1
						class="font-display text-4xl font-bold leading-[1.05] tracking-tight text-text sm:text-5xl md:text-6xl"
					>
						Gabriel<br />Ballesteros
					</h1>

					<p class="max-w-lg text-base leading-relaxed text-muted md:text-lg">
						Construyo <span class="text-text">software backend y full-stack</span>
						eficiente y escalable. Convierto ideas en sistemas funcionales,
						bien estructurados y pensados para producción.
					</p>

					<div
						class="flex flex-wrap justify-center gap-3 pt-2 md:justify-start"
					>
						<SocialLink href="https://github.com/GabJS10" label="GitHub">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 3a10.88 10.88 0 0 0-6 0c-2.64-2.5-5.36-3.5-8-3C.5 4.5.5 6.5.5 9c-.28 1.15-.28 2.35 0 3.5A5.403 5.403 0 0 0 4 18c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
						</SocialLink>
						<SocialLink
							href="https://www.linkedin.com/in/gabriel-ballesteros-3114b916a/"
							label="LinkedIn"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
						</SocialLink>
						<SocialLink href="mailto:jgabis65@gmail.com" label="Email">
							<svg width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M11 19h-6a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v6"></path><path d="M3 7l9 6l9 -6"></path><path d="M15 19l2 2l4 -4"></path></svg>
						</SocialLink>
					</div>
				</div>

				<div class="flex justify-center md:justify-end">
					<div class="relative">
						<div
							class="absolute -right-2 -top-2 h-6 w-6 border-r-2 border-t-2 border-accent"
						>
						</div>
						<div
							class="absolute -bottom-2 -left-2 h-6 w-6 border-b-2 border-l-2 border-accent"
						>
						</div>
						<Image
							src={Foto}
							alt="Gabriel Ballesteros"
							class="relative h-44 w-44 rounded-xl border border-line object-cover md:h-56 md:w-56"
						/>
					</div>
				</div>
			</div>

			<!-- Signature: system readout -->
			<dl
				class="reveal-on-scroll mt-16 grid grid-cols-2 divide-line rounded-xl border border-line bg-panel/40 font-mono text-xs md:grid-cols-4 md:divide-x"
			>
				{
					readout.map((r, i) => (
						<div
							class={`flex flex-col gap-1 px-5 py-4 ${i < 2 ? "border-b border-line md:border-b-0" : ""} ${i % 2 === 1 ? "border-l border-line md:border-l-0" : ""}`}
						>
							<dt class="tracking-widest text-muted">{r.label}</dt>
							<dd class="flex items-center gap-2 text-text">
								{r.label === "STATUS" && (
									<span class="status-dot inline-block h-1.5 w-1.5 rounded-full bg-accent" />
								)}
								{r.value}
							</dd>
						</div>
					))
				}
			</dl>
		</section>

		<!-- 01 · SOBRE MÍ -->
		<section id="sobre-mi" class="mx-auto max-w-5xl scroll-mt-24 py-24 md:py-28">
			<SectionHeader index="01" eyebrow="SOBRE MÍ" title="Ingeniero enfocado en el backend" />
			<div class="reveal-on-scroll mt-10 grid gap-12 md:grid-cols-[1.5fr_1fr]">
				<div class="space-y-5 leading-relaxed text-muted">
					<p>
						Soy ingeniero de sistemas con foco en crear soluciones
						<span class="text-text">backend y full-stack</span> eficientes y
						escalables. Trabajo con JavaScript, TypeScript, Python, Node.js y
						Next.js, integrando bases de datos SQL y NoSQL según lo que cada
						problema necesita.
					</p>
					<p>
						Me interesan los sistemas bien estructurados: colas de trabajo,
						procesamiento en segundo plano, APIs claras y arquitecturas
						pensadas para producción. Construyo proyectos reales, aprendo
						rápido y convierto ideas en software funcional.
					</p>
				</div>
				<dl class="space-y-0 divide-y divide-line rounded-xl border border-line bg-panel/40">
					{
						facts.map((f) => (
							<div class="flex items-center justify-between gap-4 px-5 py-3.5 font-mono text-xs">
								<dt class="tracking-widest text-muted">{f.label}</dt>
								<dd class="text-right text-text">{f.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<!-- 02 · STACK -->
		<section id="stack" class="mx-auto max-w-5xl scroll-mt-24 py-24 md:py-28">
			<SectionHeader
				index="02"
				eyebrow="STACK"
				title="Herramientas de trabajo"
				description="Las tecnologías con las que construyo, agrupadas por dónde encajan en el sistema."
			/>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				{
					stackGroups.map((group) => (
						<div class="reveal-on-scroll rounded-xl border border-line bg-panel/40 p-6">
							<p class="mb-5 font-mono text-xs tracking-widest text-accent">
								{group.label}
							</p>
							<ul class="space-y-3.5">
								{group.items.map((tech) => (
									<li class="flex items-center gap-3">
										<span class="inline-flex h-5 w-5 items-center justify-center [&>svg]:h-full [&>svg]:w-full">
											<Fragment set:html={techIcons[tech] || techIcons.default} />
										</span>
										<span class="font-mono text-sm text-text">{tech}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<!-- 03 · PROYECTOS -->
		<section id="proyectos" class="mx-auto max-w-5xl scroll-mt-24 py-24 md:py-28">
			<SectionHeader
				index="03"
				eyebrow="PROYECTOS"
				title="Trabajo seleccionado"
				description="Una selección de proyectos recientes, entre backend y frontend."
			/>
			<div class="mt-16 flex flex-col gap-24 md:gap-28">
				{
					projects.map((project, index) => (
						<div class="reveal-on-scroll">
							<ProjectCard
								index={String(index + 1).padStart(2, "0")}
								title={project.data.title}
								description={project.data.description}
								date={project.data.date}
								image={project.data.image}
								url={project.data.link}
								technologies={project.data.technologies}
								reverse={index % 2 !== 0}
							/>
						</div>
					))
				}
			</div>
		</section>
	</main>

	<!-- 04 · CONTACTO -->
	<footer
		id="contacto"
		class="mx-auto max-w-5xl scroll-mt-24 border-t border-line px-4 py-20 sm:px-6"
	>
		<div class="reveal-on-scroll grid gap-10 md:grid-cols-[1.5fr_1fr]">
			<div class="space-y-5">
				<div class="flex items-center gap-3 font-mono text-xs tracking-widest text-accent">
					<span>// 04</span>
					<span class="h-px w-16 bg-line"></span>
					<span class="text-muted">CONTACTO</span>
				</div>
				<h2 class="font-display text-3xl font-bold tracking-tight text-text md:text-4xl">
					¿Construimos algo?
				</h2>
				<p class="max-w-md leading-relaxed text-muted">
					Estoy disponible para nuevos proyectos y colaboraciones. La mejor vía
					es el correo, pero también me encuentras en las redes.
				</p>
				<a
					href="mailto:jgabis65@gmail.com"
					class="inline-flex items-center gap-2 font-mono text-sm tracking-wide text-accent transition-colors hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
				>
					jgabis65@gmail.com
					<span aria-hidden="true">→</span>
				</a>
			</div>
			<nav class="flex flex-col gap-3 font-mono text-sm md:items-end">
				<a href="https://github.com/GabJS10" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">GitHub ↗</a>
				<a href="https://www.linkedin.com/in/gabriel-ballesteros-3114b916a/" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">LinkedIn ↗</a>
				<a href="https://docs.google.com/document/d/1MXRKo2KKJapOG70Ydf2bWkq1aL-uaA-qlnbaygS2s2M/edit?tab=t.0" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">CV ↗</a>
			</nav>
		</div>
		<p class="mt-16 font-mono text-xs tracking-wide text-muted">
			© 2026 Gabriel Ballesteros — construido con Astro
		</p>
	</footer>
</Layout>

<script>
	const prefersReduced = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;
	const els = document.querySelectorAll(".reveal-on-scroll");

	if (prefersReduced) {
		els.forEach((el) => el.classList.add("visible"));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12 },
		);
		els.forEach((el) => observer.observe(el));
	}
</script>

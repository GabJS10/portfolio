---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { Image } from "astro:assets";
import Foto from "@/assets/foto.jpeg";
import { getCollection } from "astro:content";
import { isoDate } from "@/lib/dates";

const CV_URL =
	"https://docs.google.com/document/d/1MXRKo2KKJapOG70Ydf2bWkq1aL-uaA-qlnbaygS2s2M/edit?tab=t.0";
const EMAIL = "jgabis65@gmail.com";
const GITHUB = "https://github.com/GabJS10";
const LINKEDIN = "https://www.linkedin.com/in/gabriel-ballesteros-3114b916a/";

const navItems = [
	{ name: "Proyectos", href: "#proyectos" },
	{ name: "Sobre mí", href: "#sobre-mi" },
	{ name: "Stack", href: "#stack" },
	{ name: "Contacto", href: "#contacto" },
];

const facts = [
	{ label: "Rol", value: "Ingeniero de sistemas" },
	{ label: "Enfoque", value: "Backend / Full-stack" },
	{ label: "Ubicación", value: "Colombia" },
	{ label: "Bases de datos", value: "SQL · NoSQL" },
];

const stackGroups = [
	{ label: "Frontend", items: ["React", "Next.js", "Astro", "Tailwind CSS", "TypeScript", "JavaScript"] },
	{ label: "Backend", items: ["Node.js", "Express", "NestJS", "FastAPI", "Python"] },
	{ label: "Datos & Infra", items: ["PostgreSQL", "MongoDB", "Redis", "Docker", "Git"] },
];

// Proyectos que se exhiben, en este orden. El resto sigue en projects.json pero no se muestra.
const featured = [
	"yts-player",
	"biblia-mons-straunbinger",
	"content-creation-ia",
	"rag-system",
	"corprecam-web",
];
const collection = await getCollection("projects");
const projects = featured.flatMap((id) => collection.filter((p) => p.id === id));
const yearOf = (p: (typeof projects)[number]) => isoDate(p.data.date).slice(0, 4);
---

<Layout title="Gabriel Ballesteros | Portfolio">
	<a
		href="#proyectos"
		class="sr-only z-[60] bg-lamp px-4 py-2 text-sm text-wall focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
		>Saltar a proyectos</a
	>

	<header class="fixed inset-x-0 top-0 z-50 bg-wall/95">
		<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
			<a href="/" class="text-sm font-medium text-ink">Gabriel Ballesteros</a>
			<ul class="flex items-center gap-5 text-sm text-dim sm:gap-7">
				{
					navItems.map((item) => (
						<li class={item.name === "Proyectos" || item.name === "Contacto" ? "" : "hidden sm:block"}>
							<a href={item.href} class="transition-colors hover:text-ink">{item.name}</a>
						</li>
					))
				}
				<li>
					<a href={CV_URL} target="_blank" rel="noopener noreferrer" class="text-ink transition-colors hover:text-lamp">CV</a>
				</li>
			</ul>
		</nav>
	</header>

	<main>
		<!-- Entrada -->
		<section class="mx-auto max-w-6xl px-5 pt-32 pb-16 sm:px-8 md:pt-36 md:pb-10" aria-label="Presentación">
			<div class="grid items-end gap-16 md:grid-cols-12 md:gap-x-8">
				<div class="md:col-span-8">
					<h1 class="text-[clamp(3.25rem,8.5vw,7rem)] leading-[0.95] font-light tracking-[-0.035em] text-ink">
						Gabriel<br />Ballesteros
					</h1>
					<p class="mt-8 text-lg text-ink md:text-xl">Ingeniero de sistemas · <span class="whitespace-nowrap">Backend y full-stack</span></p>
					<p class="mt-3 max-w-[52ch] text-base leading-relaxed text-dim md:text-lg">
						Construyo software backend y full-stack eficiente y escalable. Convierto ideas en
						sistemas funcionales, bien estructurados y pensados para producción.
					</p>
					<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm">
						<a href={CV_URL} target="_blank" rel="noopener noreferrer" class="link-arrow inline-flex items-center gap-1.5 bg-ink px-5 py-3 font-medium text-wall transition-colors hover:bg-lamp">
							Ver CV
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</a>
						<a href={`mailto:${EMAIL}`} class="text-ink underline decoration-rule underline-offset-[6px] transition-colors hover:text-lamp hover:decoration-lamp">Escribir correo</a>
						<span class="inline-flex items-center gap-2 text-dim">
							<span class="h-1.5 w-1.5 rounded-full bg-lamp" aria-hidden="true"></span>
							Disponible
						</span>
					</div>
				</div>

				<!-- Retrato con su cartela -->
				<figure class="work lit w-44 md:col-span-3 md:col-start-10 md:w-full md:max-w-[220px] md:justify-self-end">
					<Image
						src={Foto}
						alt="Gabriel Ballesteros"
						width={440}
						loading="eager"
						class="work-image aspect-[4/5] w-full object-cover shadow-[0_40px_60px_-40px_rgb(0_0_0/0.9)]"
					/>
					<figcaption class="mt-4 text-sm">
						<p class="text-ink">Gabriel Ballesteros</p>
						<p class="text-dim">Retrato · Colombia</p>
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- La sala: proyectos -->
		<section id="proyectos" class="mx-auto max-w-6xl scroll-mt-16 px-5 pt-10 pb-24 sm:px-8 md:pb-32" aria-labelledby="proyectos-titulo">
			<div class="grid gap-6 border-t border-rule pt-8 md:grid-cols-12 md:gap-x-8">
				<h2 id="proyectos-titulo" class="text-3xl font-light tracking-[-0.02em] text-ink md:col-span-7 md:col-start-2 md:text-4xl">Trabajo seleccionado</h2>
				<p class="text-dim md:col-span-4">Una selección de proyectos recientes, entre backend y frontend.</p>
			</div>

			<div class="relative mt-16 flex flex-col gap-28 md:mt-14 md:gap-40">
				<span class="absolute inset-y-0 left-0 hidden w-px bg-rule md:block" aria-hidden="true"></span>
				{
					projects.map((p, i) => (
						<ProjectCard
							id={p.id}
							title={p.data.title}
							description={p.data.description}
							date={p.data.date}
							image={p.data.image}
							url={p.data.link}
							technologies={p.data.technologies}
							showYear={i === 0 || yearOf(p) !== yearOf(projects[i - 1])}
						/>
					))
				}
			</div>
		</section>

		<!-- Texto de sala: sobre mí -->
		<section id="sobre-mi" class="bg-wall-2 px-5 py-24 sm:px-8 md:py-32" aria-labelledby="sobre-mi-titulo">
			<div class="mx-auto grid max-w-[68rem] gap-12 md:grid-cols-12 md:gap-x-8">
				<h2 id="sobre-mi-titulo" class="text-3xl font-light tracking-[-0.02em] text-balance text-ink md:col-span-4 md:col-start-2 md:text-4xl">
					Ingeniero enfocado en el backend
				</h2>
				<div class="md:col-span-6 md:col-start-7">
					<div class="max-w-[62ch] space-y-5 text-[17px] leading-relaxed text-ink/80">
						<p>
							Soy ingeniero de sistemas con foco en crear soluciones backend y full-stack
							eficientes y escalables. Trabajo con JavaScript, TypeScript, Python, Node.js y
							Next.js, integrando bases de datos SQL y NoSQL según lo que cada problema necesita.
						</p>
						<p>
							Me interesan los sistemas bien estructurados: colas de trabajo, procesamiento en
							segundo plano, APIs claras y arquitecturas pensadas para producción. Construyo
							proyectos reales, aprendo rápido y convierto ideas en software funcional.
						</p>
					</div>
					<dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-rule pt-8 text-sm">
						{
							facts.map((f) => (
								<div>
									<dt class="text-dim">{f.label}</dt>
									<dd class="mt-1 text-ink">{f.value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</div>
		</section>

		<!-- Stack -->
		<section id="stack" class="mx-auto max-w-6xl px-5 py-24 sm:px-8 md:py-32" aria-labelledby="stack-titulo">
			<div class="grid gap-12 md:grid-cols-12 md:gap-x-8">
				<div class="md:col-span-4 md:col-start-2">
					<h2 id="stack-titulo" class="text-3xl font-light tracking-[-0.02em] text-ink md:text-4xl">Herramientas de trabajo</h2>
					<p class="mt-4 max-w-[36ch] text-dim">Las tecnologías con las que construyo, agrupadas por dónde encajan en el sistema.</p>
				</div>
				<div class="grid grid-cols-2 gap-10 sm:grid-cols-3 md:col-span-6 md:col-start-7">
					{
						stackGroups.map((g, gi) => (
							<div class={gi === 2 ? "col-span-2 sm:col-span-1" : ""}>
								<h3 class="text-sm text-dim">{g.label}</h3>
								<ul class={`mt-4 space-y-2 text-ink ${gi === 2 ? "columns-2 gap-10 sm:columns-1 [&>li]:break-inside-avoid" : ""}`}>
									{g.items.map((t) => <li>{t}</li>)}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<!-- Salida: contacto -->
	<footer id="contacto" class="mx-auto max-w-6xl scroll-mt-16 px-5 pt-24 pb-12 sm:px-8 md:pt-32">
		<div class="grid gap-10 border-t border-rule pt-16 md:grid-cols-12 md:gap-x-8">
			<div class="md:col-span-10 md:col-start-2">
				<h2 class="text-[clamp(2.75rem,6.5vw,5.5rem)] leading-[1] font-light tracking-[-0.035em] text-ink">¿Construimos algo?</h2>
				<p class="mt-6 max-w-[48ch] text-lg leading-relaxed text-dim">
					Estoy disponible para nuevos proyectos y colaboraciones. La mejor vía es el correo, pero
					también me encuentras en las redes.
				</p>
				<a href={`mailto:${EMAIL}`} class="mt-10 inline-block text-[clamp(1.35rem,3.2vw,2.25rem)] font-light break-all text-ink underline decoration-rule decoration-1 underline-offset-[10px] transition-colors hover:text-lamp hover:decoration-lamp">
					{EMAIL}
				</a>
				<ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm">
					{
						[
							{ name: "GitHub", href: GITHUB },
							{ name: "LinkedIn", href: LINKEDIN },
							{ name: "CV", href: CV_URL },
						].map((l) => (
							<li>
								<a href={l.href} target="_blank" rel="noopener noreferrer" class="link-arrow inline-flex items-center gap-1.5 text-ink transition-colors hover:text-lamp">
									{l.name}
									<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<p class="mt-24 text-sm text-dim">© 2026 Gabriel Ballesteros — construido con Astro</p>
	</footer>
</Layout>

<script>
	// Luz de sala: la obra que entra en la vista se ilumina; las demás quedan en penumbra.
	const works = document.querySelectorAll<HTMLElement>("main article .work");
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (reduced || !("IntersectionObserver" in window)) {
		works.forEach((w) => w.classList.add("lit"));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => entry.target.classList.toggle("lit", entry.isIntersecting));
			},
			{ rootMargin: "-25% 0px -25% 0px" },
		);
		works.forEach((w) => observer.observe(w));
	}
</script>
